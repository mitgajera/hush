# ── Solana ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# KEEP THIS SERVER-ONLY (no NEXT_PUBLIC_ prefix).
# The app proxies all RPC calls through /api/rpc — key never reaches the browser.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

NEXT_PUBLIC_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# USDC mint (mainnet)
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── Umbra ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_UMBRA_NETWORK=mainnet-beta
NEXT_PUBLIC_UMBRA_PROGRAM_ID=
NEXT_PUBLIC_UMBRA_INDEXER_URL=
NEXT_PUBLIC_UMBRA_RELAYER_URL=

# ── Credential cNFT ───────────────────────────────────────────────────────────
NEXT_PUBLIC_HUSH_COLLECTION=
NEXT_PUBLIC_HUSH_TREE=

# ── App ────────────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL — used for generating Hush link URLs
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=Hush
